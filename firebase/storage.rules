rules_version = '2';

// ---------------------------------------------------------------------------
// Wellness Lodge — Storage security rules
//
// Two zones:
//  - media/**            public property photos (rooms, hall, vehicles, past
//                         events) — public read, staff write.
//  - receipts/{bookingRef}/**   bank-transfer proof-of-payment uploads —
//                         guests may CREATE (upload) only against a booking
//                         reference that exists and is awaiting a receipt;
//                         nobody but active staff may ever read them back.
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    // Defined INSIDE this match block, not at file scope. A `firestore.get()`
    // call made from a function defined outside `match /b/{bucket}/o` compiles
    // with only a warning ("occurs outside of defining scope") -- the deploy
    // looks successful, but the call does not resolve correctly at runtime, so
    // every rule using these functions silently denies. This is the exact same
    // class of bug already found and fixed in firestore.rules this session
    // (helper functions needing to live inside the match block that binds
    // their scope) -- confirmed live: guest receipt uploads failed with
    // storage/unauthorized despite the booking's status being correct, until
    // these were moved here.
    function isActiveStaff() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function bookingAwaitingReceipt(bookingRef) {
      let b = firestore.get(/databases/(default)/documents/bookings/$(bookingRef));
      return b.data.status in ['AWAITING_RECEIPT', 'AWAITING_FRONT_DESK'];
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isActiveStaff();
    }

    match /receipts/{bookingId}/{fileName} {
      allow read: if isActiveStaff();
      allow create: if bookingAwaitingReceipt(bookingId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
      allow update, delete: if isActiveStaff();
    }
  }
}
