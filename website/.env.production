# Production Firebase Web SDK config for the "wellness-lodge" project.
#
# ROOT-CAUSE FIX: the GitHub Actions hosting-deploy workflow runs
# `npm run build` with NO environment variables set, and .env.local (which
# has these same values) is git-ignored, so every production build was
# compiling with all VITE_FIREBASE_* vars undefined -- Firestore reads for
# room categories, rates, and past events were silently failing across the
# whole site (Home, Rooms & Rates, Past Events, and the booking flow).
#
# These values are safe to commit: they identify the Firebase project to the
# browser SDK but grant no access by themselves -- actual access is enforced
# by firestore.rules / storage.rules and Cloud Functions, not by hiding this
# config. Vite loads this file automatically for `vite build` (mode
# "production" by default), so no workflow or secrets changes are needed.
VITE_FIREBASE_API_KEY=AIzaSyBcBmxYAXTR865xS1C1_IylJg1amq9SHlw
VITE_FIREBASE_AUTH_DOMAIN=wellness-lodge.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wellness-lodge
VITE_FIREBASE_STORAGE_BUCKET=wellness-lodge.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=940483961022
VITE_FIREBASE_APP_ID=1:940483961022:web:ba43c2382e8253dcc37eef
VITE_USE_EMULATORS=false
