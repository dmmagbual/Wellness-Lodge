# Firebase Web SDK config — from Firebase console > Project settings > General
# > Your apps > Web app. Safe to expose client-side (these are not secrets;
# Firestore/Storage/Functions access is controlled by the security rules and
# Cloud Functions, not by hiding this config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=wellness-lodge-demo
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the website at the local Firebase emulators
# (started with `firebase emulators:start` in /firebase) instead of a real
# project. Leave unset/false for production and staging builds.
VITE_USE_EMULATORS=true
